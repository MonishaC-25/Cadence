# GEMINI_API_KEY: Required for Gemini AI API calls (Tier 1 Primary).
# Generous free tier provided directly via Google AI Studio.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: 100% Free Forever Tier (Tier 2 Fallback).
# Free Llama 3.3 70B, up to 14,400 requests/day, no credit card needed.
# Free signup: https://console.groq.com
GROQ_API_KEY=""

# OPENROUTER_API_KEY: 100% Free Models Tier (Tier 3 Fallback).
# Free access to :free models (Llama 3.2, Mistral 7B) with no deposit.
# Free signup: https://openrouter.ai
OPENROUTER_API_KEY=""

# HUGGINGFACE_API_KEY: Free Serverless Inference Token (Tier 4 Fallback).
# Free community token for Mistral-7B / Qwen.
# Free signup: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# COHERE_API_KEY: Free Developer Trial (Tier 5 Fallback).
# Free developer access for Command-R.
# Free signup: https://dashboard.cohere.com
COHERE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

